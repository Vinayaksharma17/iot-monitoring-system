# API base URL. Leave unset (or set to /api) for the same-origin setup where
# nginx proxies /api to the backend.
VITE_API_URL=/api

# Grafana base URL for the embedded dashboards. Grafana is PRIVATE (no public
# route), so production builds leave this unset and the dashboard UI is hidden.
# For local development the app falls back to http://localhost:3001.
# VITE_GRAFANA_URL=http://localhost:3001
