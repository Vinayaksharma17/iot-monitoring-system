# ==========================================
# IoT Monitoring System - Environment Variables
# ==========================================
# Copy this file to .env and customize the values
#
# Convention: this file overrides defaults. Infra-level defaults (ports,
# NODE_ENV, DATABASE_URL) live in compose.yaml; app tunable defaults
# (LOG_LEVEL, JWT lifetimes, RETENTION_*) live in backend/src/config/env.ts.
# Secrets (POSTGRES_PASSWORD, JWT_*, SEED_*, GRAFANA_ADMIN_*) have NO
# defaults — leaving them empty/missing means "unset" or a required-value
# error from compose.

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_DB=iot_monitoring
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=iot_password
POSTGRES_PORT=5432

# ==========================================
# Backend API Configuration
# ==========================================
NODE_ENV=production
BACKEND_PORT=3000
LOG_LEVEL=info

# JWT Authentication (override in .env for production)
JWT_SECRET=change-this-access-secret-in-prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-prod
JWT_REFRESH_EXPIRES_IN=7d
# Seeded only when the users table has no admin yet. When seeding a fresh
# database in production, the password must be at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
INGEST_API_KEY=

# CORS Configuration - Frontend URL
CORS_ORIGIN=http://localhost:5173

# ==========================================
# Data Retention (raw sensor data size cap)
# ==========================================
# The backend deletes the oldest sensor_logs rows to stay within the cap.
# 5 GB of raw 1-second data (10 sensors × temp + humidity) ≈ 13-14 days.
RETENTION_MAX_SIZE_GB=5
RETENTION_CHECK_INTERVAL_MINUTES=60
RETENTION_BYTES_PER_ROW=240

# ==========================================
# Node-RED Configuration
# ==========================================
NODERED_PORT=1880
TZ=America/New_York
# Editor credentials. The password is a bcrypt hash; generate one with
# `htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'` or deploy/generate-env.sh.
# IMPORTANT: Docker Compose interpolates "$" in env-file values, so escape each
# "$" in the hash as "$$" here (e.g. $$2a$$10$$...). Without a hash the editor
# login cannot succeed (fails safe).
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD_HASH=
# Encrypts Node-RED's stored credentials: openssl rand -hex 32
NODE_RED_CREDENTIAL_SECRET=
# Set to true to run the committed flows read-only (no editor).
NODE_RED_DISABLE_EDITOR=false

# ==========================================
# Frontend build-time configuration
# ==========================================
# Vite inlines these into the bundle at image build time.
VITE_API_URL=/api
# Grafana is private in production. For the local stack this points at the
# host-published Grafana port so the embedded dashboards work; the production
# overlay overrides it with an empty value to hide the UI.
VITE_GRAFANA_URL=http://localhost:3001

# ==========================================
# Grafana Configuration
# ==========================================
# Required: compose.yaml fails to start if GRAFANA_ADMIN_PASSWORD is unset.
# Change from "admin" for any shared or internet-facing deployment.
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
# GRAFANA_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource

# ==========================================
# Adminer Configuration
# ==========================================
ADMINER_PORT=8081

# ==========================================
# Service URLs (Internal Docker Network)
# ==========================================
# Used by services to talk to each other inside the Docker network. Only change
# these if you rename services in compose.yaml. (compose.yaml sets the actual
# POSTGRES_HOST for the Node-RED container itself.)
POSTGRES_HOST=postgres
BACKEND_HOST=backend
NODERED_HOST=nodered
GRAFANA_HOST=grafana
ADMINER_HOST=adminer

# ==========================================
# Production deployment
# ==========================================
# The home-server deployment does NOT use this file. It uses deploy/.env with
# compose.production.yaml. See docs/DEPLOYMENT.md and
# deploy/.env.production.example. This file (root .env) is for local/dev use.
