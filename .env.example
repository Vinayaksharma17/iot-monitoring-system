# ==========================================
# IoT Monitoring System - Environment Variables
# ==========================================
# Copy this file to .env and customize the values

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_DB=iot_monitoring
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=iot_password
POSTGRES_PORT=5432

# ==========================================
# Backend API Configuration
# ==========================================
NODE_ENV=production
BACKEND_PORT=3000
LOG_LEVEL=info
APP_NAME=IoT Monitoring System
APP_VERSION=1.0.0

# CORS Configuration - Frontend URL
CORS_ORIGIN=http://localhost:5173

# ==========================================
# Node-RED Configuration
# ==========================================
NODERED_PORT=1880
TZ=America/New_York

# ==========================================
# Grafana Configuration
# ==========================================
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
# GRAFANA_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource

# ==========================================
# Adminer Configuration
# ==========================================
ADMINER_PORT=8081

# ==========================================
# Service URLs (Internal Docker Network)
# ==========================================
# These are used by services to communicate within Docker network
# No need to change these unless you modify service names in compose.yaml
POSTGRES_HOST=postgres
BACKEND_HOST=backend
NODERED_HOST=nodered
GRAFANA_HOST=grafana
ADMINER_HOST=adminer
