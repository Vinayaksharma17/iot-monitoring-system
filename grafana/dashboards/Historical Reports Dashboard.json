            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH stats AS (\n  SELECT \n    s.id as sensor_id,\n b.name as bedroom_name,\n    s.name as sensor_name,\n    s.type,\n    AVG(sl.value) as avg_value,\n    STDDEV(sl.value) as stddev_value\n  FROM sensor_logs sl\n  JOIN sensors s ON sl.sensor_id = s.id\n  JOIN bedrooms b ON s.bedroom_id = b.id\n  WHERE s.bedroom_id IN ($bedroom_filter)\n    AND s.id IN ($sensor_filter)\n    AND s.type IN ($sensor_type_filter)\n    AND sl.timestamp >= $__timeFrom()\n    AND sl.timestamp <= $__timeTo()\n  GROUP BY s.id, b.name, s.name, s.type\n)\nSELECT \n  TO_CHAR(sl.timestamp, 'YYYY-MM-DD HH24:MI:SS') as \"Timestamp\",\n  st.bedroom_name as \"Bedroom\",\n  st.sensor_name as \"Sensor\",\n  st.type as \"Type\",\n  ROUND(sl.value::numeric, 2) as \"Value\",\n  ROUND(st.avg_value::numeric, 2) as \"Average\",\n  ROUND((sl.value - st.avg_value)::numeric, 2) as \"Deviation\",\n  CASE \n    WHEN ABS(sl.value - st.avg_value) > 2 * st.stddev_value THEN 'Critical'\n    WHEN ABS(sl.value - st.avg_value) > st.stddev_value THEN 'Warning'\n    ELSE 'Normal'\n  END as \"Status\"\nFROM sensor_logs sl\nJOIN stats st ON sl.sensor_id = st.sensor_id\nWHERE ABS(sl.value - st.avg_value) > st.stddev_value\n  AND sl.timestamp >= $__timeFrom()\n  AND sl.timestamp <= $__timeTo()\nORDER BY sl.timestamp DESC;",
          "refId": "A"
        }
      ],
      "title": "Anomalous Readings (Beyond 1 Std Dev)",
      "type": "table"
