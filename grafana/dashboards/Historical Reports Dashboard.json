          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n  DATE(sl.timestamp) as time,\n  EXTRACT(HOUR FROM sl.timestamp)::text as metric,\n  ROUND(AVG(sl.value)::numeric, 2) as value\nFROM sensor_logs sl\nJOIN sensors s ON sl.sensor_id = s.id\nWHERE s.bedroom_id IN ($bedroom_filter)\n  AND s.id IN ($sensor_filter)\n  AND s.type IN ($sensor_type_filter)\n  AND sl.timestamp >= $__timeFrom()\n  AND sl.timestamp <= $__timeTo()\nGROUP BY DATE(sl.timestamp), EXTRACT(HOUR FROM sl.timestamp)\nORDER BY time, metric;",
          "refId": "A"
        }
