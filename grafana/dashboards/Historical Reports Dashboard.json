          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ranked_readings AS (\n  SELECT \n    sl.timestamp,\n    b.name as bedroom_name,\n    s.name as sensor_name,\n    s.type,\n    sl.value,\n    ROW_NUMBER() OVER (PARTITION BY s.id ORDER BY sl.value DESC) as high_rank,\n    ROW_NUMBER() OVER (PARTITION BY s.id ORDER BY sl.value ASC) as low_rank\n  FROM sensor_logs sl\n  JOIN sensors s ON sl.sensor_id = s.id\n  JOIN bedrooms b ON s.bedroom_id = b.id\n  WHERE s.bedroom_id IN ($bedroom_filter)\n    AND s.id IN ($sensor_filter)\n    AND s.type IN ($sensor_type_filter)\n    AND sl.timestamp >= $__timeFrom()\n    AND sl.timestamp <= $__timeTo()\n)\nSELECT \n  bedroom_name as \"Bedroom\",\n  sensor_name as \"Sensor\",\n  type as \"Type\",\n  TO_CHAR(timestamp, 'YYYY-MM-DD HH24:MI') as \"Timestamp\",\n  ROUND(value::numeric, 2) as \"Value\",\n  CASE \n    WHEN high_rank = 1 THEN 'Highest'\n    WHEN low_rank = 1 THEN 'Lowest'\n  END as \"Record\"\nFROM ranked_readings\nWHERE high_rank = 1 OR low_rank = 1\nORDER BY bedroom_name, sensor_name, \"Record\";",
          "refId": "A"
        }
      ],
      "title": "Peak Values (Highest & Lowest)",
      "type": "table"
    },
