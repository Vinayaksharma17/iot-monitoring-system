        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH first_last AS (\n  SELECT \n    s.id as sensor_id,\n    b.name as bedroom_name,\n    s.name as sensor_name,\n    s.type,\n    FIRST_VALUE(sl.value) OVER (PARTITION BY s.id ORDER BY sl.timestamp ASC) as first_value,\n    FIRST_VALUE(sl.value) OVER (PARTITION BY s.id ORDER BY sl.timestamp DESC) as last_value\n  FROM sensor_logs sl\n  JOIN sensors s ON sl.sensor_id = s.id\n  JOIN bedrooms b ON s.bedroom_id = b.id\n  WHERE s.bedroom_id IN ($bedroom_filter)\n    AND s.id IN ($sensor_filter)\n    AND s.type IN ($sensor_type_filter)\n    AND sl.timestamp >= $__timeFrom()\n    AND sl.timestamp <= $__timeTo()\n)\nSELECT DISTINCT\n  bedroom_name,\n  sensor_name,\n  CONCAT(bedroom_name, ' - ', sensor_name) as \"Sensor\",\n  type as \"Type\",\n  ROUND(first_value::numeric, 2) as \"First Value\",\n  ROUND(last_value::numeric, 2) as \"Last Value\",\n  ROUND((last_value - first_value)::numeric, 2) as \"Change\",\n  ROUND(((last_value - first_value) / NULLIF(first_value, 0) * 100)::numeric, 2) as \"Change %\"\nFROM first_last\nORDER BY bedroom_name, sensor_name;",
          "refId": "A"
        }
      ],
      "title": "Value Change Comparison (First vs Last)",
      "type": "table"
    },
