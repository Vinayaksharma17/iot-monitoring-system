          "rawQuery": true,
          "rawSql": "SELECT \n  b.name as \"Bedroom\",\n  s.type as \"Sensor Type\",\n  ROUND(MIN(sl.value)::numeric, 2) as \"Min\",\n  ROUND(MAX(sl.value)::numeric, 2) as \"Max\",\n  ROUND(AVG(sl.value)::numeric, 2) as \"Average\",\n  ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY sl.value)::numeric, 2) as \"Median\",\n  COUNT(*) as \"Readings\"\nFROM sensor_logs sl\nJOIN sensors s ON sl.sensor_id = s.id\nJOIN bedrooms b ON s.bedroom_id = b.id\nWHERE s.bedroom_id IN ($bedroom_filter)\n  AND s.id IN ($sensor_filter)\n  AND s.type IN ($sensor_type_filter)\n  AND sl.timestamp >= $__timeFrom()\n  AND sl.timestamp <= $__timeTo()\nGROUP BY b.name, s.type\nORDER BY b.name, s.type;",
