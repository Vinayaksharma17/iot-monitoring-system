      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n  CASE \n    WHEN '$aggregation_interval' = '1h' THEN DATE_TRUNC('hour', sl.timestamp)\n    WHEN '$aggregation_interval' = '6h' THEN DATE_TRUNC('hour', sl.timestamp) - (EXTRACT(HOUR FROM sl.timestamp)::int % 6) * INTERVAL '1 hour'\n    WHEN '$aggregation_interval' = '12h' THEN DATE_TRUNC('hour', sl.timestamp) - (EXTRACT(HOUR FROM sl.timestamp)::int % 12) * INTERVAL '1 hour'\n    WHEN '$aggregation_interval' = '1d' THEN DATE_TRUNC('day', sl.timestamp)\n    WHEN '$aggregation_interval' = '1w' THEN DATE_TRUNC('week', sl.timestamp)\n    ELSE DATE_TRUNC('day', sl.timestamp)\n  END as time,\n  CONCAT(b.name, ' - ', s.name) as metric,\n  ROUND(AVG(sl.value)::numeric, 2) as value\nFROM sensor_logs sl\nJOIN sensors s ON sl.sensor_id = s.id\nJOIN bedrooms b ON s.bedroom_id = b.id\nWHERE s.bedroom_id IN ($bedroom_filter)\n  AND s.id IN ($sensor_filter)\n  AND s.type IN ($sensor_type_filter)\n  AND sl.timestamp >= $__timeFrom()\n  AND sl.timestamp <= $__timeTo()\nGROUP BY time, b.name, s.name\nORDER BY time;",
          "refId": "A"
        }
      ],
      "title": "Aggregated Average Values (by ${aggregation_interval})",
      "type": "timeseries"
    },
