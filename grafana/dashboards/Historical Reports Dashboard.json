        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  DATE(sl.timestamp) as \"Date\",\n  b.name as \"Bedroom\",\n  s.name as \"Sensor\",\n  s.type as \"Type\",\n  s.unit as \"Unit\",\n  ROUND(MIN(sl.value)::numeric, 2) as \"Min Value\",\n  ROUND(MAX(sl.value)::numeric, 2) as \"Max Value\",\n  ROUND(AVG(sl.value)::numeric, 2) as \"Avg Value\",\n  ROUND(STDDEV(sl.value)::numeric, 2) as \"Std Dev\",\n  COUNT(*) as \"Reading Count\"\nFROM sensor_logs sl\nJOIN sensors s ON sl.sensor_id = s.id\nJOIN bedrooms b ON s.bedroom_id = b.id\nWHERE s.bedroom_id IN ($bedroom_filter)\n  AND s.id IN ($sensor_filter)\n  AND s.type IN ($sensor_type_filter)\n  AND sl.timestamp >= $__timeFrom()\n  AND sl.timestamp <= $__timeTo()\nGROUP BY DATE(sl.timestamp), b.name, s.name, s.type, s.unit\nORDER BY \"Date\" DESC, b.name, s.name;",
          "refId": "A"
        }
      ],
      "title": "Daily Statistics (Min/Max/Avg)",
      "type": "table"
    },
