          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (sl.sensor_id)\n  b.name as \"Bedroom\",\n  s.name as \"Sensor\",\n  ROUND(sl.value::numeric, 2) as \"Temperature\",\n  s.unit as \"Unit\",\n  CASE \n    WHEN sl.value < 22 THEN 'Too Cold'\n    WHEN sl.value >= 22 AND sl.value <= 26 THEN 'Optimal'\n    WHEN sl.value > 26 AND sl.value <= 30 THEN 'Warm'\n    ELSE 'Too Hot'\n  END as \"Status\",\n  sl.timestamp as \"Last Update\"\nFROM sensor_logs sl\nJOIN sensors s ON sl.sensor_id = s.id\nJOIN bedrooms b ON s.bedroom_id = b.id\nWHERE s.type = 'temperature'\n  AND s.is_active = true\nORDER BY sl.sensor_id, sl.timestamp DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Temperature Status Table",
      "type": "table"
