          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (sl.sensor_id)\n  b.name as \"Bedroom\",\n  s.name as \"Sensor\",\n  ROUND(sl.value::numeric, 2) as \"Humidity\",\n  s.unit as \"Unit\",\n  CASE \n    WHEN sl.value < 30 THEN 'Too Dry'\n    WHEN sl.value >= 30 AND sl.value < 40 THEN 'Low'\n    WHEN sl.value >= 40 AND sl.value <= 60 THEN 'Optimal'\n    WHEN sl.value > 60 AND sl.value <= 70 THEN 'High'\n    ELSE 'Too Humid'\n  END as \"Status\",\n  sl.timestamp as \"Last Update\"\nFROM sensor_logs sl\nJOIN sensors s ON sl.sensor_id = s.id\nJOIN bedrooms b ON s.bedroom_id = b.id\nWHERE s.type = 'humidity'\n  AND s.is_active = true\nORDER BY sl.sensor_id, sl.timestamp DESC;",
          "refId": "A",
