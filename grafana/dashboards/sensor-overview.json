      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  CONCAT(b.name, ' - ', s.name) as bedroom,\n  s.type,\n  ROUND(AVG(sl.value)::numeric, 2) as avg_value,\n  ROUND(MIN(sl.value)::numeric, 2) as min_value,\n  ROUND(MAX(sl.value)::numeric, 2) as max_value\nFROM sensor_logs sl\nJOIN sensors s ON sl.sensor_id = s.sensor_id\nJOIN bedrooms b ON s.bedroom_id = b.bedroom_id\nWHERE sl.recorded_at >= NOW() - INTERVAL '24 hours'\nGROUP BY b.name, s.name, s.type\nORDER BY b.name, s.type",
          "refId": "A",
          "sql": {
