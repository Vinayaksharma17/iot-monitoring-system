          "rawSql": "SELECT\n  sl.recorded_at AS time,\n  sl.value,\n  CONCAT(b.name, ' - ', s.name) as metric\nFROM sensor_logs sl\nJOIN sensors s ON sl.sensor_id = s.sensor_id\nJOIN bedrooms b ON s.bedroom_id = b.bedroom_id\nWHERE s.type = 'temperature'\n  AND sl.recorded_at >= NOW() - INTERVAL '24 hours'\nORDER BY sl.recorded_at",
