# Production environment for the home server.
#
# Copy to deploy/.env (never commit that file) and fill in real values.
# Generate strong secrets with: ./deploy/generate-env.sh
# Use it with:  docker compose --env-file deploy/.env -f compose.yaml -f compose.production.yaml ...
#
# NOTE ON ESCAPING: Docker Compose interpolates "$" inside env-file values, so
# every literal "$" MUST be written as "$$". This matters for bcrypt hashes
# (NODE_RED_ADMIN_PASSWORD_HASH), e.g. "$$2a$$10$$...". generate-env.sh does this
# for you automatically.

# ---------------------------------------------------------------------------
# Public endpoint (Cloudflare Tunnel -> http://127.0.0.1:5173)
# ---------------------------------------------------------------------------
# Exact scheme+host users browse. Placeholder until DNS/tunnel is configured.
PUBLIC_ORIGIN=https://<PUBLIC_HOSTNAME>

# Host's Tailscale address (100.x.y.z). Required only by compose.admin.yaml
# (admin UIs bound to this interface). Find it with: tailscale ip -4
TAILSCALE_IP=100.64.0.1

# Image tag to deploy. Releases publish an immutable tag (git SHA or vX.Y.Z)
# plus "latest". Pin a specific tag for reproducible deploys.
IMAGE_TAG=latest

# Only this port is published (loopback), for the tunnel.
FRONTEND_PORT=5173

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=iot_monitoring
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (defaults live in backend/src/config/env.ts)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-openssl-rand-hex-48
JWT_REFRESH_SECRET=change-me-openssl-rand-hex-48differently
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOG_LEVEL=info

# First-login admin (used only when seeding an empty database; must be >= 12
# chars in production). Change it after the first login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-at-least-12-chars

# Shared secret for machine data ingestion (Node-RED -> backend). The
# X-API-Key header is enforced only when this is set, so keep it set.
INGEST_API_KEY=change-me-openssl-rand-hex-32

# 5 GB rolling retention window
RETENTION_MAX_SIZE_GB=5
RETENTION_CHECK_INTERVAL_MINUTES=15
RETENTION_BYTES_PER_ROW=240

# Browser origin allowed to call the API (same-origin through the tunnel).
CORS_ORIGIN=https://<PUBLIC_HOSTNAME>

# ---------------------------------------------------------------------------
# Grafana (private; reachable over tailnet / SSH port-forward only)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-random

# ---------------------------------------------------------------------------
# Node-RED (editor private; auth REQUIRED)
# ---------------------------------------------------------------------------
NODE_RED_ADMIN_USER=admin
# bcrypt hash, with "$" doubled ("$$2a$$10$$..."). generate-env.sh handles it.
NODE_RED_ADMIN_PASSWORD_HASH=change-me-bcrypt-hash
# Encrypts Node-RED's stored credentials. openssl rand -hex 32
NODE_RED_CREDENTIAL_SECRET=change-me-openssl-rand-hex-32
NODE_RED_DISABLE_EDITOR=false

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
TZ=America/New_York

# Remote used by deploy/backup.sh retention (days)
BACKUP_RETENTION_DAYS=14
