# ==========================================
# Backend Environment Variables
# ==========================================
# Defaults for app tunables live in src/config/env.ts — leave a variable
# unset to use the default. Only set what you want to override.

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://iot_user:iot_password@postgres:5432/iot_monitoring
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Max JSON body size accepted by the API
BODY_LIMIT=100kb

# CORS Configuration (comma-separated list of origins)
CORS_ORIGIN=http://localhost:5173

# Set when running behind a reverse proxy / load balancer so client IPs
# (and rate limiting) use X-Forwarded-For. Examples: "1", "true"
# TRUST_PROXY=1

# Logging
LOG_LEVEL=info

# Rate limiting (in-memory, per process)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ==========================================
# Authentication & Security
# ==========================================
# JWT secrets: generate strong values (e.g., `openssl rand -base64 32`)
JWT_SECRET=change-this-to-a-strong-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-strong-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Initial admin user (seeded only if table is empty). Leave empty to skip
# seeding. When actually seeding in production the password must be at least
# 12 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password

# Optional: protect the active sensors endpoint for ingestion (Node-RED)
# When set, incoming requests must provide header X-API-Key matching this value.
# Leave empty to allow unauthenticated reads (current setup expects that).
INGEST_API_KEY=

# ==========================================
# Data Retention (sensor_logs size cap)
# ==========================================
# Deletes the oldest raw readings when sensor_logs exceeds the cap.
# 0 disables the job. (In docker-compose these are read from the root .env.)
RETENTION_MAX_SIZE_GB=5
RETENTION_CHECK_INTERVAL_MINUTES=60
# Bytes per row including indexes (measured on this dataset: ~243).
RETENTION_BYTES_PER_ROW=240
